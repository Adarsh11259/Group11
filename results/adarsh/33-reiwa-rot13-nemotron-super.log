def poly_degree(poly):
    if poly == 0:
        return -1
    return poly.degree()

def poly_lc(poly):
    return poly.coefficient(poly.degree())

def poly_sub(f, g):
    return f - g

def poly_mul_scalar(f, s):
    return f * s

def poly_shift(f, k):
    return f * x^k

def poly_mod_naive(f, g, n):
    """Compute f mod g over Z/nZ[x]. Returns remainder or raises ValueError if lc(g) not invertible."""
    f = f % n
    g = g % n
    dg = poly_degree(g)
    if dg < 0:
        raise ValueError("Division by zero")
    
    lc_g = poly_lc(g)
    try:
        lc_g_inv = inverse_mod(lc_g, n)
    except:
        raise ValueError(f"Leading coefficient {lc_g} not invertible")
    
    r = f
    while poly_degree(r) >= dg and r != 0:
        factor = poly_lc(r) * lc_g_inv % n
        shift = poly_degree(r) - dg
        r = r - factor * poly_shift(g, shift)
        r = r % n
    
    return r

def poly_gcd_extended(f, g, n):
