from helper import *
from sage.all import *

# Try PARI's znlog via subprocess with correct syntax
print("Trying PARI znlog with correct syntax...")
import subprocess

# PARI syntax: znlog(Mod(a,n), b) computes discrete log of a base b mod n
y_str = str(y)
p_str = str(p)

# Write a gp script
gp_script = f"""
a = Mod({y_str}, {p_str});
result = znlog(a, 9);
print(result);
"""
with open('dlog.gp', 'w') as f:
    f.write(gp_script)

result = subprocess.run(['gp', '-q', 'dlog.gp'], capture_output=True, text=True)
print(f"PARI stdout: {result.stdout}")
print(f"PARI stderr: {result.stderr}")

# Also try SageMath discrete_log with Integer objects
print("\nTrying SageMath discrete_log...")
try:
    from sage.all import discrete_log
    p_int = Integer(p)
    y_int = Integer(y)
    x = discrete_log(y_int, Integer(9), p_int)
    print(f"x = {x}")
except Exception as e:
    print(f"discrete_log failed: {e}")

# Try using GF(p) with proper element creation
print("\nTrying GF(p) element log...")
try:
    F = GF(Integer(p))
    y_elem = F(Integer(y))
    base_elem = F(Integer(9))
    x = y_elem.log(base_elem)
    print(f"x = {x}")
except Exception as e:
    print(f"GF(p) log failed: {e}")

