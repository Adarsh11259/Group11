from helper import *
from Crypto.Util.number import long_to_bytes
import hashlib

q = (p - 1) // 2
g = pow(9, 1, p)
ginv = pow(g, -1, p)
yinv = pow(y, -1, p)
n = 256

M = [[(k[i] >> b) & 1 for b in range(n)] for i in range(n)]
F = GF(q)
Minv = Matrix(F, M).inverse()

Ai = [c[i] * yinv % p * pow(ginv, k[i], p) % p for i in range(n)]
hb = [pow(ginv, 1 << (b + 1), p) for b in range(n)]

x = 0
for b in range(n):
    Z = 1
    row = Minv[b]
    for i in range(n):
        e = int(row[i])
        if e:
            Z = Z * pow(Ai[i], e, p) % p
    if Z != 1:
        assert Z == hb[b], (b, "mismatch")
        x |= 1 << b

assert pow(9, x, p) == y
key = hashlib.sha384(long_to_bytes(x)).digest()
flag = bytes(a ^ b for a, b in zip(enc, key))
print(flag)
open("flag.txt", "w").write(flag.decode())
