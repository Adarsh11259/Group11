from helper import *

R.<x, y> = PolynomialRing(ZZ)

X = 2^2006
Y = 2^736
A = N - 1
B = -1
C = -1
D = 1

m = 3
monomials = []
for deg in range(1, m + 1):
    for k in range(1, deg + 1):
        for i in range(deg - k + 1):
            j = deg - k - i
            monomials.append((i, j, k))

w = len(monomials)
print("Lattice dimension w =", w)
M = Matrix(ZZ, w, w)

for row_idx, (i, j, k) in enumerate(monomials):
    poly = (A * x * y + B * x + C * y + D)^k * x^i * y^j
    scale = X^(m - k - i) * Y^(m - k - j) * (e^(m - k))
    for col_idx, (mi, mj, mk) in enumerate(monomials):
        coeff = poly.monomial_coefficient(x^mi * y^mj)
        M[row_idx, col_idx] = coeff * (X^mi) * (Y^mj) * scale

print("Running LLL...")
L = M.LLL(delta=0.99)
print("LLL done.")

found = False
for r in range(w):
    vec = L[r]
    g = 0
    for col_idx, (mi, mj, mk) in enumerate(monomials):
        c_mine = ZZ(vec[col_idx] // (X^mi * Y^mj))
        g += c_mine * x^mi * y^mj
    if g == 0:
        continue
    R_y = PolynomialRing(QQ, 'y')
    y_var = R_y.gen()
    g_y = g.subs(x = y_var)
    if g_y != 0:
        roots = g_y.roots()
        print("Row", r, "degree", g_y.degree(), "roots:", roots)
        for kp_val, _ in roots:
            kp_int = ZZ(kp_val)
            p = gcd(kp_int, N)
            if 1 < p < N:
                q = N // p
                phi = (p - 1) * (q - 1)
                d = inverse_mod(e, phi)
                m_val = pow(c, d, N)
                flag_bytes = long_to_bytes(m_val)
                print("FLAG:", flag_bytes)
                with open("flag.txt", "w") as f:
                    f.write(flag_bytes.decode())
                found = True
                break
    if found:
        break
