import socket
from helper import p

small_m = 2 * 7 * 13 * 19 * 53 * 1777 * 13873
n = (p - 1) // small_m

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect(('127.0.0.1', 11292))
data = b""
while b'Coefficients' not in data:
    chunk = s.recv(4096)
    if not chunk: break
    data += chunk
lines = data.decode().strip().split('\n')
ss = eval(lines[1].split(': ')[1])
alphas = eval(lines[2].split(': ')[1])

ss_proj = [pow(x, n, p) for x in ss]
al_proj = [pow(x, n, p) for x in alphas]

print("ss_proj == 1?", [x == 1 for x in ss_proj])
print("al_proj == 1?", [x == 1 for x in al_proj])

# Check if ss_proj is geometric
if ss_proj[0] != 1:
    s_cand = (ss_proj[1] * pow(ss_proj[0], -1, p)) % p
    print("ss_proj geometric?", [ss_proj[i] == pow(s_cand, i+1, p) for i in range(7)])

# Check if al_proj[i] == ss_proj[i]^k for some k in 1..small_m
for i in range(7):
    found = False
    for k in range(1, small_m):
        if al_proj[i] == pow(ss_proj[i], k, p):
            print(f"i={i}: al_proj[i] == ss_proj[i]^{k}")
            found = True
            break
    if not found:
        print(f"i={i}: no small k found")
s.close()
