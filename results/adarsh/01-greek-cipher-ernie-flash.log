import random, math

text = open('./public/greek.txt').read().strip()
greek_chars = sorted(set(c for c in text if c not in " !',.?_"))
print("Unique greek letters:", len(greek_chars), greek_chars)

words = text.replace('{', ' ').replace('}', ' ').replace('_', ' ').split()
for w in sorted(set(words), key=lambda x: (len(x), x)):
    print(f"{w} -> {''.join(chr(97 + greek_chars.index(c)) if c in greek_chars else c for c in w)}")

# Let's also do simulated annealing with quadgrams if available, or word-pattern constraint propagation
# First let's see the pattern output
for w in sorted(set(words), key=len, reverse=True):
    pat = []
    for c in w:
        if c in greek_chars:
            pat.append(chr(ord('a') + greek_chars.index(c)))
        else:
            pat.append(c)
    print(w, ":", "".join(pat))
