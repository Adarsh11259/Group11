# Try a completely different approach: Use the fact that we have 9 samples
# to set up a system and solve for p using integer programming or exhaustive search on small factors

# Actually, let's try the GCD of (N_i * Q_j - N_j * Q_i) where Q_i = N_i // p
# If we can find Q_i/Q_j ratio, we can compute p.

# The ratio N_i/N_j = Q_i/Q_j * (1 + O(2^-111))
# So Q_i/Q_j is the best rational approximation to N_i/N_j with denominator ~2^666
# We can use the continued fraction of N_i/N_j and look at ALL convergents with denominator ~2^666

print("\n=== Continued fraction search on all convergents ===")
for i in range(n_samples):
    for j in range(i+1, n_samples):
        ratio = N[i] / N[j]
        cf = continued_fraction(ratio)
        convs = cf.convergents()
        for idx, conv in enumerate(convs):
            if idx > 200:
                break
            num = ZZ(conv.numerator())
            den = ZZ(conv.denominator())
            # Check if this could be Q_i/Q_j (both ~666 bits)
            if num.nbits() > 600 and num.nbits() < 750 and den.nbits() > 600 and den.nbits() < 750:
                p_cand1 = N[i] // num
                p_cand2 = N[j] // den
                for p_cand in [p_cand1, p_cand2]:
                    if p_cand.nbits() > 440 and p_cand.nbits() < 450:
                        good = True
                        for k in range(n_samples):
                            if (N[k] % p_cand).nbits() > 334:
                                good = False
                                break
                        if good:
                            print(f"N[{i}]/N[{j}] convergent {idx}: *** FOUND p = {p_cand} ***")
                            p = p_cand
                            break
                if 'p' in locals():
                    break
        if 'p' in locals():
            break
    if 'p' in locals():
        break

# Try using the "nearest integer" continued fraction (more accurate)
print("\n=== Nearest integer continued fraction ===")
for i in range(min(3, n_samples)):
    for j in range(i+1, min(4, n_samples)):
        ratio = N[i] / N[j]
        # Sage doesn't have built-in nearest integer CF, but we can use the fact that
        # the error is 2^-111 relative, so we need a CF that handles larger errors.
        # Let's try the standard CF but with more convergents and check all candidates.
        cf = continued_fraction(ratio)
        convs = cf.convergents()
        for idx, conv in enumerate(convs):
            if idx > 500:
                break
            num = ZZ(conv.numerator())
            den = ZZ(conv.denominator())
            # Check a wider range of bit lengths
            if num.nbits() > 550 and num.nbits() < 800 and den.nbits() > 550 and den.nbits() < 800:
                p_cand1 = N[i] // num
                p_cand2 = N[j] // den
                for p_cand in [p_cand1, p_cand2]:
                    if p_cand.nbits() > 440 and p_cand.nbits() < 450:
                        good = True
                        for k in range(n_samples):
                            if (N[k] % p_cand).nbits() > 334:
                                good = False
                                break
                        if good:
                            print(f"N[{i}]/N[{j}] convergent {idx}: *** FOUND p = {p_cand} ***")
                            p = p_cand
                            break
                if 'p' in locals():
                    break
        if 'p' in locals():
            break
    if 'p' in locals():
        break

# Decrypt if p found
if 'p' in locals():
    print(f"\n=== DECRYPTING with p = {p} ===")
    flag_parts = []
    for i in range(n_samples):
        n_i = N[i]
        c_i = C[i]
        
        modulus = n_i - (n_i % p)  # p * Q_i
        print(f"Modulus {i}: {modulus.nbits()} bits")
        
        phi = (p - 1) * (modulus // p - 1)
        d = inverse_mod(e, phi)
        m = pow(c_i, d, modulus)
        
        m_bytes = m.to_bytes(128, 'big')
        flag_part = m_bytes[-5:]
        print(f"Flag part {i}: {flag_part}")
        flag_parts.append(flag_part)
    
    flag = b''.join(flag_parts)
    print(f"Flag: {flag}")
    
    with open('./flag.txt', 'w') as f:
        f.write(flag.decode())
else:
