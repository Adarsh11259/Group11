# SageMath script - Final attack using integer linear algebra
from sage.all import *

# Load data
output = open('public/output.txt').read().split('\n')
p = int(output[0].split('= ')[1])
y = int(output[1].split('= ')[1])
enc = bytes.fromhex(output[2].split('= ')[1])
k, c = [], []
for i in output[3:-1]:
    if i.strip():
        parts = i.split(' ')
        k.append(int(parts[0]))
        c.append(int(parts[1]))

F = GF(p)
h = pow(9, -2, p)
y_inv = pow(y, -1, p)

# Compute lhs[i] = c_i * y^{-1} * 9^{-k_i} = h^(x & k_i)
lhs = []
for i in range(len(k)):
    val = (c[i] * y_inv * pow(9, -k[i], p)) % p
    lhs.append(val)

# Build binary matrix K (256x256)
K = matrix(ZZ, [[(k[i] >> j) & 1 for j in range(256)] for i in range(256)])
print("K matrix built")

# Compute K inverse over integers (since det(K) is odd)
K_inv = K.inverse()
print("K_inv computed over integers")

# Verify K * K_inv = I
I_check = K * K_inv
print("K * K_inv is identity:", I_check == matrix.identity(256))

# For each bit j, compute v = (K^T)^{-1} e_j = (K_inv^T)[:, j]
# Since K_inv is over integers, v has integer entries
K_inv_T = K_inv.transpose()

# Precompute g_j = h^(2^j) mod p
g = [pow(h, 1 << j, p) for j in range(256)]

# Recover each bit of x
x_bits = []
for j in range(256):
    # v = (K^T)^{-1} e_j = j-th column of K_inv_T
    v = [int(K_inv_T[i, j]) for i in range(256)]
    
    # Compute R_j = prod_i lhs[i]^v_i mod p
    R = 1
    for i in range(256):
        if v[i] != 0:
            R = (R * pow(lhs[i], v[i], p)) % p
    
    # Check if R == 1 (x_j=0) or R == g_j (x_j=1)
    if R == 1:
        x_bits.append(0)
    elif R == g[j]:
        x_bits.append(1)
    else:
        print(f"ERROR at bit {j}: R = {R}, g_j = {g[j]}")
        x_bits.append(0)  # fallback

# Reconstruct x
x = 0
for j in range(256):
    if x_bits[j]:
        x |= (1 << j)

print(f"Recovered x: {x}")
print(f"x bits: {x.bit_length()}")

# Verify by checking y == 9^x mod p
y_check = pow(9, x, p)
print(f"y check: {y_check == y}")

# Decrypt flag
import hashlib
key = hashlib.sha384(x.to_bytes(32, 'big')).digest()
flag = bytes([a ^ b for a, b in zip(enc, key)])
print(f"Flag: {flag}")

# Save flag
with open('flag.txt', 'wb') as f:
    f.write(flag)

print("Flag saved to flag.txt")
