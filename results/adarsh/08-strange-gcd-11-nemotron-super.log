sage << 'EOF' 2>&1
from helper import *

n = len(N)
K = 2^333

# Build lattice for approximate GCD
# Matrix: [K*I | N] as rows, plus [0...0 | K]
M = Matrix(ZZ, n+1, n+1)
for i in range(n):
    M[i, i] = K
    M[i, n] = N[i]
M[n, n] = K

L = M.LLL()

# Check short vectors
for i in range(L.nrows()):
    row = L[i]
    # Skip trivial solutions
    nonzeros = sum(1 for j in range(n) if row[j] != 0)
    if nonzeros <= 1:
        continue
    
    s = sum(row[j] * N[j] for j in range(n))
    if s == 0:
        continue
    
    for j in range(n):
        g = gcd(s, N[j])
        if g > 1 and g.bit_length() > 300:
            max_r = max((N[k] % g).bit_length() for k in range(n))
            if max_r < 340:
                print(f"FOUND p! bits={g.bit_length()}, max_rem={max_r}")
                p = g
                e = 0x1337
                from Crypto.Util.number import long_to_bytes
                flag_parts = []
                for idx in range(n):
                    q = N[idx] // p
                    n_actual = p * q
                    phi = (p - 1) * (q - 1)
                    d = inverse_mod(e, phi)
                    m = pow(C[idx], d, n_actual)
                    part = long_to_bytes(m)
                    flag_parts.append(part)
                flag = b''.join(flag_parts)
                print(f"FLAG: {flag}")
                with open('./flag.txt', 'w') as f:
                    f.write(flag.decode())
                quit()

print("Not found with this lattice")
EOF
