from Crypto.Util.number import long_to_bytes
import math
import subprocess

print(f"Loaded {len(N)} moduli and {len(C)} ciphertexts")

# Lattice-based approach to find shared prime p
# N[i] = p * Q[i] + R[i] where R[i] is small (333 bits)
# We want to find p such that N[i] mod p is small for all i

# Construct lattice for approximate common divisor problem
# Using the approach: find small a[i] such that sum(a[i]*N[i]) is close to multiple of p

# Build matrix for lattice reduction
# We'll use the orthogonal lattice approach

K = 2**333  # Bound on R[i]

# Matrix: rows are [K at position i, N[i] at last column]
# Plus a row for the bound
n = len(N)
dim = n + 1

M = []
for i in range(n):
    row = [0] * dim
    row[i] = K
    row[n] = N[i]
    M.append(row)

# Add bound row
row = [0] * dim
row[n] = K
M.append(row)

print(f"Matrix dimension: {dim}x{dim}")
print(f"Matrix entries (first row): {M[0][:5]}...")

# Write matrix to file for flatter
with open('/tmp/lattice.txt', 'w') as f:
    f.write(f"{dim}\n")
    for row in M:
        f.write(' '.join(str(x) for x in row) + '\n')

print("Matrix written to /tmp/lattice.txt")

# Run flatter
result = subprocess.run(['flatter'], input=open('/tmp/lattice.txt').read(), capture_output=True, text=True)
