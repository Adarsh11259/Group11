n = Integer(n)
e = 137
c1 = Integer(c1)
c2 = Integer(c2)

encrypted_flag = b"\xdb'\x0bL\x0f\xca\x16\xf5\x17>\xad\xfc\xe2\x10$(DVsDS~\xd3v\xe2\x86T\xb1{xL\xe53s\x90\x14\xfd\xe7\xdb\xddf\x1fx\xa3\xfc3\xcb\xb5~\x01\x9c\x91w\xa6\x03\x80&\xdb\x19xu\xedh\xe4"

deltas = []
for signs in itertools.product([1, -1], repeat=10):
    delta = 0
    for i in range(10):
        delta += signs[i] * 13 * (256 ** (9 - i))
    deltas.append(delta % n)

print(f"Testing {len(deltas)} possible deltas...")

def poly_trim(poly, n):
    poly = poly % n
    while poly.degree() >= 0 and poly.coefficient(poly.degree()) % n == 0:
        poly = poly - poly.coefficient(poly.degree()) * x^poly.degree()
    return poly

def poly_div_mod(f, g, n):
    """Divide f by g over Z/nZ[x]. Returns (q, r) or raises ZeroDivisionError if leading coeff not invertible."""
    f = poly_trim(f, n)
    g = poly_trim(g, n)
    if g == 0:
        raise ZeroDivisionError("Division by zero polynomial")
    
    q = R(0)
    r = f
    lc_g = g.coefficient(g.degree())
    
    try:
        lc_g_inv = inverse_mod(lc_g, n)
    except:
        raise ZeroDivisionError(f"Leading coefficient {lc_g} not invertible mod {n}")
    
    while r != 0 and r.degree() >= g.degree():
        factor = r.coefficient(r.degree()) * lc_g_inv % n
        shift = r.degree() - g.degree()
        q = q + factor * x^shift
        r = r - factor * x^shift * g
        r = poly_trim(r, n)
    
    return q, r

def poly_gcd_zmod(f, g, n):
    f = poly_trim(f, n)
    g = poly_trim(g, n)
    
    while g != 0:
        try:
            q, r = poly_div_mod(f, g, n)
            f, g = g, r
        except ZeroDivisionError as ex:
            lc = g.coefficient(g.degree())
            g_val = gcd(Integer(lc), n)
            if 1 < g_val < n:
                return f, g_val
            raise ex
    
    return f, None

R.<x> = PolynomialRing(Zmod(n))

found = False
for i, delta in enumerate(deltas):
    try:
        f1 = x^e - c1
        f2 = (x + delta)^e - c2
        g, factor = poly_gcd_zmod(f1, f2, n)
        if factor is not None:
            print(f"Delta {i}: Found factor {factor} of n!")
            p = factor
            q = n // p
            phi = (p-1)*(q-1)
            d = inverse_mod(e, phi)
            key_val = pow(c1, d, n)
            key_bytes = long_to_bytes(int(key_val))
            if len(key_bytes) == 10 and all(c in ascii_lowercase.encode() for c in key_bytes):
                print(f"Key: {key_bytes}")
                key_hash = hashlib.sha256(key_bytes).digest()
                cipher = AES.new(key_hash, AES.MODE_ECB)
                flag = cipher.decrypt(encrypted_flag)
                print(f"Flag: {flag}")
                with open('./flag.txt', 'w') as f:
                    f.write(flag.decode() if isinstance(flag, bytes) else str(flag))
                found = True
                break
        elif g.degree() == 1:
            a = g.coefficient(1)
            b = g.coefficient(0)
            try:
                a_inv = inverse_mod(a, n)
                key_val = (-b * a_inv) % n
                key_bytes = long_to_bytes(int(key_val))
                if len(key_bytes) == 10 and all(c in ascii_lowercase.encode() for c in key_bytes):
                    print(f"Found key at delta {i}: {key_bytes}")
                    key_hash = hashlib.sha256(key_bytes).digest()
                    cipher = AES.new(key_hash, AES.MODE_ECB)
                    flag = cipher.decrypt(encrypted_flag)
                    print(f"Flag: {flag}")
                    with open('./flag.txt', 'w') as f:
                        f.write(flag.decode() if isinstance(flag, bytes) else str(flag))
                    found = True
                    break
            except:
                continue
    except Exception as ex:
        continue

if not found:
    print("Key not found!")

