from helper import *
from hashlib import sha384
from Crypto.Util.number import long_to_bytes

p = p
y = y
enc = enc
K = k
C = c

q = (p - 1) // 2

# h = 9^-2 mod p
h = pow(9, -2, p)

# compute g_i
yinv = pow(y, -1, p)
g = []
for i in range(len(K)):
    ci = C[i]
    ki = K[i]
    gi = ci * yinv % p
    gi = gi * pow(pow(9, ki, p), -1, p) % p
    g.append(gi)

n = 256
# build matrix M[i][b] = bit b of K[i]
from sage.all import Matrix, Zmod, GF

Mrows = []
for i in range(n):
    ki = K[i]
    row = [ (ki >> b) & 1 for b in range(n) ]
    Mrows.append(row)

M = Matrix(Zmod(q), Mrows)
try:
    Minv = M.inverse()
except Exception as e:
    print("inverse failed", e)
    raise

# v_b = prod_i g_i^{Minv[b][i]}
v = []
for b in range(n):
    val = 1
    row = Minv[b]
    for i in range(n):
        e = int(row[i])
        if e:
            val = val * pow(g[i], e, p) % p
    v.append(val)

# determine bits
xbits = []
for b in range(n):
    target0 = 1
    target1 = pow(h, pow(2, b, q), p)  # h^(2^b) mod p; exponent int
    if v[b] == 1:
        xbits.append(0)
    else:
        xbits.append(1)

x = 0
for b in range(n):
    if xbits[b]:
        x |= (1 << b)

print("x =", x)
# verify
print("9^x == y ?", pow(9, x, p) == y)

key = sha384(long_to_bytes(x)).digest()
flag = bytes([a ^ b for a, b in zip(enc, key)])
print("FLAG:", flag)
open('flag.txt','wb').write(flag)
