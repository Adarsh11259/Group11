import math
from fractions import Fraction
from helper import N, C

def lll_reduction(B, delta=Fraction(99, 100)):
    B = [list(map(int, row)) for row in B]
    n = len(B)
    m = len(B[0])
    
    def gram_schmidt(B):
        B_star = [[Fraction(0) for _ in range(m)] for _ in range(n)]
        mu = [[Fraction(0) for _ in range(n)] for _ in range(n)]
        B_norm = [Fraction(0) for _ in range(n)]
        for i in range(n):
            B_star[i] = [Fraction(B[i][j]) for j in range(m)]
            for j in range(i):
                mu[i][j] = sum(Fraction(B[i][k]) * B_star[j][k] for k in range(m)) / B_norm[j]
                for k in range(m):
                    B_star[i][k] -= mu[i][j] * B_star[j][k]
            B_norm[i] = sum(x * x for x in B_star[i])
        return B_star, mu, B_norm

    _, mu, B_norm = gram_schmidt(B)
    k = 1
    while k < n:
        for j in range(k - 1, -1, -1):
            if abs(mu[k][j]) > Fraction(1, 2):
                q = int(round(mu[k][j]))
                for l in range(m):
                    B[k][l] -= q * B[j][l]
                _, mu, B_norm = gram_schmidt(B)
        if B_norm[k] >= (delta - mu[k][k-1] ** 2) * B_norm[k - 1]:
            k += 1
        else:
            B[k], B[k - 1] = B[k - 1], B[k]
            _, mu, B_norm = gram_schmidt(B)
            k = max(k - 1, 1)
    return B

N = [int(x) for x in N]
C = [int(x) for x in C]
e = 0x1337

B = []
for i in range(9):
    row = [N[i]] + [0] * 9
    row[i + 1] = 1
    B.append(row)

B_red = lll_reduction(B)
p = 0
for i in range(9):
    if B_red[i][0] == 0:
        s = sum(B_red[i][j + 1] * N[j] for j in range(9))
        p = math.gcd(p, abs(s))

print("Recovered p bits:", p.bit_length())

flag_bytes = b""
for i in range(9):
    Q = N[i] // p
    assert p * Q == N[i], "p does not divide N[i]"
    phi = (p - 1) * (Q - 1)
    d = pow(e, -1, phi)
    m = pow(C[i], d, p * Q)
    m_bytes = m.to_bytes(128, 'big')
    flag_bytes += m_bytes[128 - 5:]

flag_str = flag_bytes.decode('latin1')
print("Decrypted flag:", flag_str)
with open("flag.txt", "w") as f:
    f.write(flag_str)
