from helper import *
from string import ascii_lowercase
import itertools
import hashlib
from Crypto.Cipher import AES

n = Integer(n)
e = 137
c1 = Integer(c1)
c2 = Integer(c2)

encrypted_flag = b"\xdb'\x0bL\x0f\xca\x16\xf5\x17>\xad\xfc\xe2\x10$(DVsDS~\xd3v\xe2\x86T\xb1{xL\xe53s\x90\x14\xfd\xe7\xdb\xddf\x1fx\xa3\xfc3\xcb\xb5~\x01\x9c\x91w\xa6\x03\x80&\xdb\x19xu\xedh\xe4"

R.<x> = PolynomialRing(Zmod(n))

# Generate all possible deltas for ROT13
# Each character position contributes either +13 or -13 in byte value
deltas = []
for signs in itertools.product([1, -1], repeat=10):
    delta = 0
    for i in range(10):
        delta += signs[i] * 13 * (256 ** (9 - i))
    deltas.append(delta % n)

print(f"Testing {len(deltas)} possible deltas...")

found = False
for i, delta in enumerate(deltas):
    try:
        f1 = x^e - c1
        f2 = (x + delta)^e - c2
        g = gcd(f1, f2)
        if g.degree() == 1:
            a = g.coefficient(1)
            b = g.coefficient(0)
            key_val = (-b * inverse_mod(a, n)) % n
            key_bytes = long_to_bytes(int(key_val))
            if len(key_bytes) == 10 and all(c in ascii_lowercase.encode() for c in key_bytes):
                print(f"Found key at delta {i}: {key_bytes}")
                key_hash = hashlib.sha256(key_bytes).digest()
                cipher = AES.new(key_hash, AES.MODE_ECB)
                flag = cipher.decrypt(encrypted_flag)
                print(f"Flag: {flag}")
                found = True
                break
    except Exception as ex:
        continue

if not found:
    print("Key not found!")

