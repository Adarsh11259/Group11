from helper import *
import itertools

R = PolynomialRing(Zmod(n), 'x')
x = R.gen()

# D = sum of s_i * 256^(9-i), s_i in {+1,-1}, i=0..9
powers = [256**(9-i) for i in range(10)]

def poly_gcd(a, b):
    while b:
        a, b = b, a % b
    return a

found = None
for signs in itertools.product([1,-1], repeat=10):
    D = sum(s*p for s,p in zip(signs, powers))
    delta = 13*D
    f = x**e - c1
    g = (x + delta)**e - c2
    g = g % f if False else g
    # compute gcd over Zmod(n)
    try:
        gg = poly_gcd(f, g)
    except Exception as ex:
        continue
    if gg.degree() == 1:
        # root
        m = -gg[0]/gg[1]
        found = m
        print("FOUND D=", D, "m=", m)
        break

if found is not None:
    key = long_to_bytes(int(found))
    print("key =", key)
    import hashlib
    from Crypto.Cipher import AES
    k = hashlib.sha256(key).digest()
    cipher = AES.new(k, AES.MODE_ECB)
    flag = cipher.decrypt(encrypted_flag)
    print("FLAG =", flag)
    open("flag.txt","w").write(flag.decode(errors='replace'))
else:
    print("not found")
