from helper import *
from Crypto.Util.number import long_to_bytes

e = 0x1337

def cf_convergents(a, b):
    # convergents h/k of a/b
    convs = []
    h0, h1 = 0, 1
    k0, k1 = 1, 0
    while b:
        q = a // b
        a, b = b, a - q*b
        h0, h1 = h1, q*h1 + h0
        k0, k1 = k1, q*k1 + k0
        convs.append((h1, k1))
    return convs

N0, N1 = N[0], N[1]
found_p = None
for (h, k) in cf_convergents(N0, N1):
    if h == 0:
        continue
    cand = N0 // h
    if cand <= 1:
        continue
    r0 = N0 - cand*h
    r1 = N1 - cand*k
    if 0 <= r0 < (1<<333) and 0 <= r1 < (1<<333):
        found_p = cand
        break

assert found_p is not None, "p not found"
p = found_p
print("p bits:", p.bit_length())

flag_bytes = b""
for i in range(9):
    Qi = N[i] // p
    assert N[i] - p*Qi < (1<<333)
    mod = p * Qi
    phi = (p-1)*(Qi-1)
    d = pow(e, -1, phi)
    m = pow(C[i], d, mod)
    mb = long_to_bytes(m)
    if len(mb) < 128:
        mb = b"\x00"*(128-len(mb)) + mb
    flag_bytes += mb[-5:]

print(flag_bytes)
open("./flag.txt","wb").write(flag_bytes)
