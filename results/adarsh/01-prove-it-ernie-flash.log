from helper import p
import math, random

small_m = 2 * 7 * 13 * 19 * 53 * 1777 * 13873
n = (p - 1) // small_m

# Trial division up to 10^8
d = 2
factors = []
step = 1
while d * d <= 10**16 and d < 10**8:
    while n % d == 0:
        factors.append(d)
        n //= d
    d += step
    step = 2

print("Trial division up to 1e8 factors:", factors)
print("Remaining bits:", n.bit_length())

# Pollard's rho on remaining n
def pollard_rho(n, max_iter=2000000):
    if n % 2 == 0: return 2
    while True:
        c = random.randrange(1, n - 1)
        f = lambda x: (pow(x, 2, n) + c) % n
        x, y, d = 2, 2, 1
        for _ in range(max_iter):
            x = f(x)
            y = f(f(y))
            d = math.gcd(abs(x - y), n)
            if 1 < d < n:
                return d
            if d == n:
                break
    return None

f1 = pollard_rho(n, 500000)
print("Pollard rho found:", f1)
if f1:
    print("n // f1 bits:", (n // f1).bit_length())
