def poly_mod(p, q, mod):
    """Return p mod q where q is monic. p, q are lists of coefficients high->low."""
    p = p[:]
    while len(p) >= len(q) and p[0] != 0:
        factor = p[0]
        shift = len(p) - len(q)
        for i in range(len(q)):
            p[i+shift] = (p[i+shift] - factor * q[i]) % mod
        # trim leading zeros
        while p and p[0] == 0:
            p.pop(0)
    return p

