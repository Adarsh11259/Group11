from Crypto.Util.number import long_to_bytes, bytes_to_long
import hashlib
from Crypto.Cipher import AES
import codecs
import math

# Load data
n = 
e = 137
c1 = 
c2 = 
encrypted_flag = b"\xdb'\x0bL\x0f\xca\x16\xf5\x17>\xad\xfc\xe2\x10$(DVsDS~\xd3v\xe2\x86T\xb1{xL\xe53s\x90\x14\xfd\xe7\xdb\xddf\x1fx\xa3\xfc3\xcb\xb5~\x01\x9c\x91w\xa6\x03\x80&\xdb\x19xu\xedh\xe4"

# Precompute powers of 256
pow256 = [1]
for i in range(1, 11):
    pow256.append(pow256[-1] * 256)
weights = [pow256[9-i] for i in range(10)]

# Polynomial ring over Zmod(n)
R = PolynomialRing(Zmod(n), 'x')
x = R.gen()

f = x^e - c1

# Precompute binomial coefficients
binom = [math.comb(e, k) for k in range(e+1)]

def monic_gcd(a, b):
    """Return monic GCD of a and b in R. Assumes a, b are polynomials in R."""
    while b != 0:
        lc = b.leading_coefficient()
        # Check if lc is invertible
        try:
            inv_lc = lc^(-1)
        except ZeroDivisionError:
            # lc is a zero divisor, we can factor n
            # Actually, we can compute gcd(lc.lift(), n) to get factor
            print("Found zero divisor:", lc)
            factor = math.gcd(lc.lift(), n)
            print("Factor of n:", factor)
            # We can then compute modulo p and q separately
            # For now, just return None
            return None
        # Make b monic
        b_monic = b * inv_lc
        # Divide a by b_monic
        _, r = a.quo_rem(b_monic)
        a, b = b_monic, r
    # a is monic
    return a

for mask in range(1024):
    D = 0
    for i in range(10):
        sign = 1 if (mask >> i) & 1 else -1
        D += sign * 13 * weights[i]
    D = D % n
    
    # Build g = (x + D)^e - c2
    coeffs = [0] * (e + 1)
    D_pow = [1]
    for i in range(1, e+1):
        D_pow.append((D_pow[-1] * D) % n)
    for k in range(e+1):
        coeff = (binom[k] * D_pow[e - k]) % n
        coeffs[e - k] = coeff
    coeffs[-1] = (coeffs[-1] - c2) % n
    g = R(coeffs)
    
