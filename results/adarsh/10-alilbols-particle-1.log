# Lattice for h*f ≡ g mod q
B = Matrix(ZZ, [[1, h], [0, q]]).LLL()
print("LLL rows:")
for row in B:
    print("  len digits:", len(str(abs(row[0]))), len(str(abs(row[1]))))

bound = int(sqrt(2) * 10**d)
