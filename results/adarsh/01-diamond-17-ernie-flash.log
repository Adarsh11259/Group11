from helper import *
from sage.all import *
import itertools

B2 = Matrix(ZZ, 7, 320, B_list)
Rred = B2.LLL()
nonzero = [Rred[i] for i in range(7) if max(abs(x) for x in Rred[i])>0]
print("num nonzero rows", len(nonzero))

M = Matrix(ZZ, 64, 25, M_list)
Mflat = M.list()

# A is 320x5, columns are the 5 vectors (length 320). A.list() order is row-major.
# Try all sign combos and column orders to make A in [10,1000) and A xor M in [0,1000)
found = None
for signs in itertools.product([1,-1], repeat=5):
    cols = [signs[k]*nonzero[k] for k in range(5)]
    # build A 320x5
    A = Matrix(ZZ, 320, 5)
    for k in range(5):
        for r in range(320):
            A[r,k] = cols[k][r]
    Alist = A.list()
    if all(10 <= x < 1000 for x in Alist):
        As = [Alist[i] ^ Mflat[i] for i in range(1600)]
        if all(0 <= x < 1000 for x in As):
            found = (A, As)
            print("FOUND with signs", signs)
            break
if found:
    A, As = found
    print("A recovered, sample A row0", A.row(0))
    print("As sample", As[:10])
else:
    print("no sign combo worked; need column order search too")
