from helper import *
from math import gcd, sqrt
from fractions import Fraction

# h and c are loaded from helper.py
print(f"h digits: {len(str(h))}")
print(f"c digits: {len(str(c))}")

# Estimate d: q = 4 * 100^d = 4 * 10^(2d), h < q
# h has ~400 digits, so 2d ≈ 400, d ≈ 200
# Let's try d values around 200

def continued_fraction(n, d):
    """Generate continued fraction convergents of n/d"""
    convergents = []
    a = n // d
    p0, p1 = 0, 1
    q0, q1 = 1, 0
    convergents.append((p1, q1))  # a/1
    
    r = n % d
    while r != 0:
        n, d = d, r
        a = n // d
        p0, p1 = p1, a * p1 + p0
        q0, q1 = q1, a * q1 + q0
        convergents.append((p1, q1))
        r = n % d
    
    return convergents

def try_d(d_val):
    q = 4 * (100 ** d_val)
    
    # h/q continued fraction convergents give k/f
    convs = continued_fraction(h, q)
    
    limit = int(sqrt(2) * 10**d_val)
    
    for k, f in convs:
        if f == 0:
            continue
        if f > limit:
            continue
        if gcd(f, 10) != 1:
            continue
        
        # Compute g = f*h mod q
        g = (f * h) % q
        
        # Check constraints: 10^d < g < sqrt(2)*10^d, gcd(f, 10*g) == 1
        if g <= 10**d_val or g >= limit:
            continue
        if gcd(f, 10 * g) != 1:
            continue
        
        print(f"Found candidate: d={d_val}, f={f}, g={g}, k={k}")
        
        # Verify: f*h ≡ g (mod q)
        if (f * h - g) % q != 0:
            print("  Verification failed!")
            continue
        
        # Now decrypt
        # c = r*(h+1) + m mod q
        # f*c ≡ r*(g+f) + f*m (mod q)
        # Since r*(g+f) + f*m < q, no mod reduction
        V = (f * c) % q
        
        # V = r*(g+f) + f*m
        # We need to find r and m
        # gcd(g+f, f) = gcd(g, f) = 1 (since gcd(f,g)=1)
        
        # Try to solve: V = r*(g+f) + f*m
        # m = (V - r*(g+f)) / f
        # We need m < 10^d and r < 10^d/2
        
        # From V mod f: V ≡ r*(g+f) ≡ r*g (mod f)
        # So r ≡ V * g^(-1) (mod f)
        
        try:
            g_inv = pow(g, -1, f)
        except:
            continue
        
        r0 = (V * g_inv) % f
        
        # r = r0 + t*f for some t
        # V = (r0 + t*f)*(g+f) + f*m
        # V - r0*(g+f) = t*f*(g+f) + f*m
        # (V - r0*(g+f)) / f = t*(g+f) + m
        
        rem = V - r0 * (g + f)
        if rem % f != 0:
            continue
        
        rem_div_f = rem // f
        
        # rem_div_f = t*(g+f) + m
        # m < 10^d, g+f > 10^d
        
        # Try t = 0 first
        m = rem_div_f
        t = 0
        r = r0
        
        if m < 0:
            # Try negative t or adjust
            # m = rem_div_f - t*(g+f), need 0 <= m < 10^d
            # t = ceil(rem_div_f / (g+f)) approximately
            t = -((-rem_div_f) // (g + f))
            m = rem_div_f - t * (g + f)
            r = r0 + t * f
        
        # Check if we need to adjust t
        while m >= 10**d_val:
            t -= 1
            m = rem_div_f - t * (g + f)
            r = r0 + t * f
        
        while m < 0:
            t += 1
            m = rem_div_f - t * (g + f)
            r = r0 + t * f
        
        print(f"  r={r}, m={m}")
        print(f"  r < 10^d/2: {r < 10**d_val // 2}")
        print(f"  m < 10^d: {m < 10**d_val}")
        
        if r >= 0 and r < 10**d_val // 2 and m >= 0 and m < 10**d_val:
            # Verify encryption
            c_check = (r * (h + 1) + m) % q
            if c_check == c:
                print(f"  SUCCESS! Decrypted m={m}")
                # Convert m to bytes
                m_bytes = m.to_bytes((m.bit_length() + 7) // 8, 'big')
                print(f"  Flag: {m_bytes}")
                return m_bytes
    
    return None

# Try d values around 200
for d_val in range(195, 210):
    print(f"\nTrying d={d_val}...")
    result = try_d(d_val)
    if result:
        print(f"\nFound flag with d={d_val}!")
        break
else:
    print("No solution found in range 195-210")

