try:
    x = F(y_sage).log(F(Integer(9)))
    elapsed = time.time() - start
    print(f"x = {x}")
    print(f"Time: {elapsed:.2f} seconds")
    
    # Decrypt flag
    import hashlib
    key = hashlib.sha384(long_to_bytes(int(x))).digest()
    flag = bytes([i^j for (i,j) in zip(enc, key)])
    print(f"flag = {flag}")
    
    with open('flag.txt', 'w') as f:
        f.write(flag.decode())
    print("Flag saved to flag.txt")
except Exception as e:
    print(f"Failed: {e}")
    print(f"Time elapsed: {time.time() - start:.2f} seconds")

