from helper import *
from fractions import Fraction
import math

n = len(N)
print(f"n = {n}")
print(f"N[0] bits = {N[0].bit_length()}")

def continued_fraction_convergents(a, b):
    """Compute convergents of a/b using Euclidean algorithm."""
    convergents = []
    # Standard continued fraction computation
