python3 -c "
from helper import *
n=len(N)
def cf(a,b):
    r=[]
    while b:r.append(a//b);a,b=b,a%b
    return r
def conv(cf):
    o=[];p2,p1=0,1;q2,q1=1,0
    for ai in cf:
        p=ai*p1+p2;q=ai*q1+q2;o.append((p,q));p2,p1=p1,p;q2,q1=q1,q
    return o
pf=None
for i in range(n):
  for j in range(i+1,n):
    for qi,qj in conv(cf(N[i],N[j])):
      if 600<qi.bit_length()<700 and 600<qj.bit_length()<700:
        pe=N[i]//qi
        if 400<pe.bit_length()<460:
          mr=max((N[m]%pe).bit_length() for m in range(n))
          if mr<340:
            pf=pe;break
    if pf:break
  if pf:break
if pf:
    e=0x1337
    from Crypto.Util.number import long_to_bytes
    fp=[]
    for idx in range(n):
        q=N[idx]//pf;na=pf*q;ph=(pf-1)*(q-1);d=pow(e,-1,ph)
        fp.append(long_to_bytes(pow(C[idx],d,na)))
    flag=b''.join(fp)
    open('flag.txt','w').write(flag.decode())
    print(flag.decode())
" > /tmp/final_result.txt 2>&1; cat /tmp/final_result.txt
