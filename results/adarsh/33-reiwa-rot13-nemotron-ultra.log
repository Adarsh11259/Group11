# Precompute powers of 256
pow256 = [1]
for i in range(1, 11):
    pow256.append(pow256[-1] * 256)
weights = [pow256[9-i] for i in range(10)]

# Polynomial ring over Zmod(n)
R = PolynomialRing(Zmod(n), 'x')
x = R.gen()

f = x^e - c1

# Precompute binomial coefficients
binom = [math.comb(e, k) for k in range(e+1)]

for mask in range(1024):
    D = 0
    for i in range(10):
        sign = 1 if (mask >> i) & 1 else -1
        D += sign * 13 * weights[i]
    D = D % n
    
