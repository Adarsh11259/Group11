from helper import *

n = len(N)

def cf_convergents(a, b):
    cf = []
    while b != 0:
        cf.append(a // b)
        a, b = b, a % b
    convs = []
    p_im2, p_im1 = 0, 1
    q_im2, q_im1 = 1, 0
    for ai in cf:
        p = ai * p_im1 + p_im2
        q = ai * q_im1 + q_im2
        convs.append((p, q))
        p_im2, p_im1 = p_im1, p
        q_im2, q_im1 = q_im1, q
    return convs

found = False
p_found = None

for i in range(n):
    for j in range(i+1, n):
        convs = cf_convergents(N[i], N[j])
        for k, (qi, qj) in enumerate(convs):
            if 600 < qi.bit_length() < 700 and 600 < qj.bit_length() < 700:
                p_est = N[i] // qi
                if 400 < p_est.bit_length() < 460:
                    max_r = max((N[m] % p_est).bit_length() for m in range(n))
                    if max_r < 340:
                        p_found = p_est
                        found = True
                        break
        if found:
            break
    if found:
        break

if found:
    e = 0x1337
    from Crypto.Util.number import long_to_bytes
    flag_parts = []
    for idx in range(n):
        q = N[idx] // p_found
        n_actual = p_found * q
        phi = (p_found - 1) * (q - 1)
        d = pow(e, -1, phi)
        m = pow(C[idx], d, n_actual)
        part = long_to_bytes(m)
        flag_parts.append(part)
    flag = b''.join(flag_parts)
    with open('./flag.txt', 'w') as f:
        f.write(flag.decode())
    print(f"FLAG: {flag.decode()}")
else:
    print("NOT FOUND")

