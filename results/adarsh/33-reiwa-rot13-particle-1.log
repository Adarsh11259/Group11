from helper import *
R = PolynomialRing(Zmod(n), 'x')
x = R.gen()

def mygcd(a, b):
    while b != 0:
        a, b = b, a % b
    if a != 0:
        a = a.monic()
    return a

f1 = x**e - R(c1)
found = None
for mask in range(1024):
    delta = 0
    for i in range(10):
        s = 1 if (mask >> (9-i)) & 1 else -1
        delta += s * 13 * 256**(9-i)
    f2 = (x + R(delta))**e - R(c2)
    g = mygcd(f1, f2)
    if g.degree() >= 1:
        found = (mask, delta, g)
        print("FOUND mask", mask, "delta", delta, "deg", g.degree())
        break
    if mask % 100 == 0:
        print("tried", mask, flush=True)

if found:
    mask, delta, g = found
    # root of g
    m1 = int(-g[0] / g[1]) % n
    print("m1 =", m1)
    m1_bytes = m1.to_bytes(10, 'big')
