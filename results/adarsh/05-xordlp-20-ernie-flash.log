from helper import *
from Crypto.Util.number import long_to_bytes
import hashlib

q = (p - 1) // 2
g = pow(9, 1, p)
ginv = pow(g, -1, p)
yinv = pow(y, -1, p)

n = len(k)
assert n == 256

# M[i][b] = bit b of k_i
M = [[(k[i] >> b) & 1 for b in range(256)] for i in range(256)]

# adjugate via fraction-free Gauss-Jordan over Z
A = [row[:] + [1 if i == j else 0 for j in range(n)] for i, row in enumerate(M)]
prev = 1
for c in range(n):
    piv = next(r for r in range(c, n) if A[r][c] != 0)
    if piv != c:
        A[c], A[piv] = A[piv], A[c]
    pv = A[c][c]
    for r in range(n):
        if r == c or A[r][c] == 0:
            continue
        f = A[r][c]
        A[r] = [pv * A[r][j] - f * A[c][j] for j in range(2 * n)]
        A[r][c] = 0
    prev = pv
# A[i][n+j] = det(M) * (M^{-1})[j][i]
# compute det(M)*Minv mod q via: adj[j][i] = A[i][n+j] / prod(pivots)
det = 1
# recompute pivots product
B = [row[:] for row in M]
for c in range(n):
    piv = next(r for r in range(c, n) if B[r][c] != 0)
    if piv != c:
        B[c], B[piv] = B[piv], B[c]
    det *= B[c][c]
detinv = pow(det % q, -1, q)
# Minv[j][i] = A[i][n+j] * detinv mod q
Minv = [[(A[i][n + j] * detinv) % q for i in range(n)] for j in range(n)]

# A_i = c_i * y^{-1} * 9^{-k_i}
Ai = [c[i] * yinv % p * pow(ginv, k[i], p) % p for i in range(n)]

hb = [pow(ginv, 1 << (b + 1), p) for b in range(256)]

x = 0
for b in range(256):
    Z = 1
    row = Minv[b]
    for i in range(n):
        if row[i]:
            Z = Z * pow(Ai[i], row[i], p) % p
    bit = 0 if Z == 1 else 1
    if bit:
        assert Z == hb[b], (b, "mismatch")
    x |= bit << b

assert pow(9, x, p) == y
key = hashlib.sha384(long_to_bytes(x)).digest()
flag = bytes(a ^ b for a, b in zip(enc, key))
print(flag)
open("flag.txt", "w").write(flag.decode())
