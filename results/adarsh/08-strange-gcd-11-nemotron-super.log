from helper import *

n = len(N)

# Continued fraction convergents
def cf_convergents(a, b):
    cf = []
    while b != 0:
        cf.append(a // b)
        a, b = b, a % b
    
    convs = []
    p_im2, p_im1 = 0, 1
    q_im2, q_im1 = 1, 0
    for ai in cf:
        p = ai * p_im1 + p_im2
        q = ai * q_im1 + q_im2
        convs.append((p, q))
        p_im2, p_im1 = p_im1, p
        q_im2, q_im1 = q_im1, q
    return convs

# Try all pairs
found = False
p_found = None

for i in range(n):
    for j in range(i+1, n):
