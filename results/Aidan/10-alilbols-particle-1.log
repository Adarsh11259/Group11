from helper import h, c
from math import gcd, isqrt
from Crypto.Util.number import long_to_bytes

L = len(str(h))
print("h digits:", L)
print("c digits:", len(str(c)))

def convergents(num, den):
    a, b = num, den
    p2, p1 = 0, 1
    q2, q1 = 1, 0
    while b:
        cf = a // b
        p = cf * p1 + p2
        q = cf * q1 + q2
        yield p, q
        a, b = b, a - cf * b
        p2, p1 = p1, p
        q2, q1 = q1, q

cands = []
base = L // 2
for d in range(max(1, base - 3), base + 4):
    q = 4 * 100 ** d
    if q <= h:
        continue
    B = isqrt(2 * 10 ** (2 * d))
    low = 10 ** d
    for k, f in convergents(h, q):
        if f >= B and f != 1:
            break
        if not (1 <= f < B):
            continue
        g = f * h - k * q
        if low <= g < B:
            if gcd(f, 10 * g) == 1:
                cands.append((d, q, f, g, k))

print("candidates:", len(cands))
for d, q, f, g, k in cands:
    G = f + g
    try:
        invf = pow(f, -1, G)
    except ValueError:
        continue
    a = (f * c) % q
    m = (a * invf) % G
    if m < 10 ** d:
        b = long_to_bytes(m)
        print("d", d)
        print("f", f)
        print("g", g)
        print("m", m)
        print("bytes", repr(b))
        if b'CCTF{' in b:
            print("FLAG", b.decode(errors='replace'))
            open('flag.txt','wb').write(b)
            break
else:
    print("no flag candidate")

