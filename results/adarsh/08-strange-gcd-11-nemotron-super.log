from helper import *
from gmpy2 import *
from Crypto.Util.number import long_to_bytes

# N and C are already loaded from helper.py
print(f"Loaded {len(N)} moduli and {len(C)} ciphertexts")

# Step 1: Find p by computing gcd of differences
# N[i] - N[j] = p*(Q[i] - Q[j]) + (R[i] - R[j])
# Since R[i] is small (333 bits), gcd of multiple differences should reveal p

import math

# Compute pairwise differences and their gcd
g = 0
for i in range(len(N)):
    for j in range(i+1, len(N)):
        diff = abs(N[i] - N[j])
        g = math.gcd(g, diff)
        print(f"gcd after N[{i}]-N[{j}]: {g.bit_length()} bits")

print(f"\nCandidate p: {g}")
print(f"p bit length: {g.bit_length()}")

# Step 2: Verify p divides N[i] - R[i] for some small R[i]
# Check if N[i] % p is small for all i
p = g
for i in range(len(N)):
    r = N[i] % p
    print(f"N[{i}] % p = {r} ({r.bit_length()} bits)")

# Step 3: Compute Q[i] = N[i] // p and decrypt
e = 0x1337
flag_parts = []

for i in range(len(N)):
    q = N[i] // p
    n_actual = p * q
    phi = (p - 1) * (q - 1)
    d = invert(e, phi)
    m = pow(C[i], d, n_actual)
    part = long_to_bytes(m)
    # Strip padding (leading random bytes)
    # The flag part should be at the end
    print(f"C[{i}] decrypted: {part}")
    flag_parts.append(part)

# Combine flag parts
flag = b''.join(flag_parts)
print(f"\nFlag: {flag}")
print(f"Flag string: {flag.decode()}")

# Save flag to file
with open('./flag.txt', 'w') as f:
    f.write(flag.decode())

print("\nFlag saved to flag.txt")

