from sage.all import *
import itertools

Bf = eval(open('public/B_list.txt').read())
M = eval(open('public/M_list.txt').read())
B = Matrix(ZZ, 7, 320, Bf)
Ls = B.row_module(ZZ).saturation()
Bb = Ls.basis_matrix().LLL()

ieqs = []
for i in range(320):
    col = vector(QQ, [Bb[l][i] for l in range(5)])
    ieqs.append([-10] + list(col))
    ieqs.append([1000] + [-x for x in col])
P = Polyhedron(ieqs=ieqs, base_ring=QQ)
pts = list(P.integral_points())
print("num pts", len(pts))

# column vectors for each point
cols = []
for u in pts:
    v = sum(u[l]*Bb[l] for l in range(5))
    v = vector(ZZ, v)
    print("col min/max", min(v), max(v))
    cols.append(v)

# try all permutations of column order
for perm in itertools.permutations(range(5)):
    # order columns as cols[perm[0]], ..., build A columns
    Acols = [cols[perm[k]] for k in range(5)]
    # A is 320x5, row major flat: entry (i,k) at i*5+k
    flat = []
    for i in range(320):
        for k in range(5):
            flat.append(int(Acols[k][i]))
    a_flat = [M[j] ^ flat[j] for j in range(1600)]
    if all(0 <= x <= 999 for x in a_flat):
        print("VALID perm", perm)
        print("a_flat max", max(a_flat), "min", min(a_flat))
        # save A columns in this order
        import json
        with open("sol_A.txt","w") as f:
            for k in range(5):
                f.write(str(list(Acols[k]))+"\n")
        with open("sol_aflat.txt","w") as f:
            f.write(str(a_flat)+"\n")
        break
