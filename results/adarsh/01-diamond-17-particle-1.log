Basis = Ls.basis_matrix().LLL()
print("LLL shape", Basis.nrows(), Basis.ncols())
allv = Basis.list()
print("min", min(allv), "max", max(allv))

# The columns of A are in this lattice, entries in [10,1000].
# Enumerate short vectors of the lattice that lie in [10,1000]^320.
# First, estimate: scale so that A columns become short. Do a big enumeration.
# Set up for Babai/enumeration with a box constraint. Use exhaustive
# CVP-style enumeration over coefficient range.
Bb = Basis.change_ring(ZZ)

# Compute Gram-Schmidt info by trying enumeration over small coordinate range.
# Initially, find approximate coefficients by checking combos with small integers.
# We'll do a simple enumeration: coefficients in [-K,K]^5.
import itertools
K = 3
found = 0
for coeffs in itertools.product(range(-K,K+1), repeat=5):
    if all(c==0 for c in coeffs): 
        continue
    v = sum(coeffs[i]*Bb[i] for i in range(5))
    if min(v) >= 10 and max(v) <= 1000:
        print("FOUND candidate with coeffs", coeffs)
        print("entries min/max", min(v), max(v))
        found += 1
        if found >= 5:
            break
print("total found", found)
